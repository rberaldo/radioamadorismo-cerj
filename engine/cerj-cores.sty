%% cerj-cores.sty
%% Paleta CERJ. Usada pelo tema (beamerthemecerj.sty) e pelas figuras
%% compiladas à parte (classe standalone), para que tudo tenha as mesmas cores.
%%
%% Duas fontes:
%%  - Papel timbrado oficial do CERJ: Azul CERJ #003366 e seus tons misturados
%%    ao branco (Azul CERJ 80, 60, 40, 20, 10).
%%  - Emblema (img/cerj-logo.png): cores medidas nos pixels.
%%
%% Oficiais (papel timbrado)
%%   cerjAzul      #003366  Azul CERJ, azul institucional
%%   cerjAzul80    #335C85  azul médio
%%   cerjAzul60    #6685A3  azul médio-claro
%%   cerjAzul40    #99ADC2  azul claro
%%   cerjAzul20    #CCD6E0  azul muito claro
%%   cerjAzul10    #E6EBF0  azul quase branco
%% Do emblema
%%   cerjBlue      #3C4398  azul do emblema (anel, letras, montanha)
%%   cerjGreen     #44AC6A  verde do emblema (vegetação)
%%   cerjGreenVivid#11B255  verde vivo do emblema (realces na vegetação)
%%   cerjYellow    #F6EFAB  creme do emblema (anel interno, nó)
%% Derivadas, para leitura (contraste de texto sobre branco entre parênteses)
%%   cerjGreenDark #338150  verde do emblema escurecido, para texto/\alert (4,8:1)
%%   cerjInk       #001F3D  Azul CERJ escurecido, texto corrido (16,6:1)
%%   cerjPaper     #FAFAFA  fundo dos slides: quase branco, ofusca menos no
%%                          projetor que o branco puro do papel timbrado
%% Nomes usados pelo tema
%%   cerjNavy  = cerjAzul    fundos escuros (título, seções, barra do título)
%%   cerjRoyal = cerjAzul80  preenchimentos médios
%%
%% O verde e o creme do emblema são claros demais para texto sobre branco
%% (2,9:1 e 1,2:1); sobre o Azul CERJ funcionam bem (4,4:1 e 10,7:1).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cerj-cores}[2026/11/07 v0.2 Paleta CERJ]

\RequirePackage{xcolor}

% Oficiais (papel timbrado)
\definecolor{cerjAzul}{HTML}{003366}
\definecolor{cerjAzul80}{HTML}{335C85}
\definecolor{cerjAzul60}{HTML}{6685A3}
\definecolor{cerjAzul40}{HTML}{99ADC2}
\definecolor{cerjAzul20}{HTML}{CCD6E0}
\definecolor{cerjAzul10}{HTML}{E6EBF0}

% Do emblema
\definecolor{cerjBlue}{HTML}{3C4398}
\definecolor{cerjGreen}{HTML}{44AC6A}
\definecolor{cerjGreenVivid}{HTML}{11B255}
\definecolor{cerjYellow}{HTML}{F6EFAB}

% Derivadas
\definecolor{cerjGreenDark}{HTML}{338150}
\definecolor{cerjInk}{HTML}{001F3D}
\definecolor{cerjPaper}{HTML}{FAFAFA}

% Nomes usados pelo tema
\colorlet{cerjNavy}{cerjAzul}
\colorlet{cerjRoyal}{cerjAzul80}

\endinput
