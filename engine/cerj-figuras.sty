%% cerj-figuras.sty
%% Preâmbulo comum das figuras TikZ em figuras/ (classe standalone, 11pt).
%% Mesma fonte (Fira Sans, do metropolis), tamanhos e cores do tema: incluído
%% sem escala, o PDF fica idêntico a um desenho feito direto no slide.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cerj-figuras}[2026/11/08 v0.1 Preambulo das figuras TikZ do curso CERJ]

\RequirePackage{fontspec}
\setsansfont[BoldFont={Fira Sans}]{Fira Sans Light}
\renewcommand{\familydefault}{\sfdefault}

\RequirePackage{tikz}
\usetikzlibrary{positioning, arrows.meta, calc}
\RequirePackage{fontawesome5}
\RequirePackage{cerj-cores}

% Figuras são compiladas a partir da raiz do projeto
\graphicspath{{img/}}


% ---------------------------------------------------------------------------
% Logos de outras organizações
% ---------------------------------------------------------------------------
% \orglogo{arquivo}{alternativa}: logo de img/logos/arquivo.pdf ou .png (ou de
% img/arquivo.png, como o do CERJ) numa caixa de 1 × 0,8 cm. Sem o arquivo,
% imprime a alternativa (ex.: um ícone).
\newcommand{\orglogo}[2]{%
  \IfFileExists{img/logos/#1.pdf}{\includegraphics[width=1cm,height=.8cm,keepaspectratio]{logos/#1}}{%
    \IfFileExists{img/logos/#1.png}{\includegraphics[width=1cm,height=.8cm,keepaspectratio]{logos/#1}}{%
      \IfFileExists{img/#1.png}{\includegraphics[width=1cm,height=.8cm,keepaspectratio]{#1}}{#2}}}}

% \orgcartao{arquivo}{alternativa}{nome}: logo e nome lado a lado, alinhados
% em colunas fixas, para usar dentro de um nó TikZ.
\newcommand{\orgcartao}[3]{%
  \makebox[1cm]{$\vcenter{\hbox{\orglogo{#1}{#2}}}$}\hspace{.5em}\makebox[2.1cm][l]{\small\bfseries #3}}
