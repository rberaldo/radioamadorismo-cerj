%% cerj-macros.sty
%% Macros de conteúdo para o curso: links e referências (natbib), figuras
%% TikZ compiladas à parte (\figura, \figurapassos), abreviações, caixas de
%% destaque (Dica / Atenção / Regulamento), listas de ✓/✗, foto com legenda,
%% comentários e o slide de foto em tela cheia.
%% Depende da paleta (cerj-cores.sty, via o tema) e das unidades (cerj-unidades.sty).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cerj-macros}[2026/11/07 v0.1 Macros do curso de radioamadorismo CERJ]

\RequirePackage{booktabs}
\RequirePackage{cerj-unidades}   % siunitx, \freq e \freqrange
\RequirePackage{tikz}              % só o \cerjfullimage; os desenhos ficam em figuras/
\RequirePackage{xspace}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fontawesome5}

% URLs na fonte do texto, não em monoespaçado
\urlstyle{same}

% Endereço guardado numa macro, escrito e clicável: \mostrarlink{\linkCERJ}
% (\url sozinho não expande a macro e escreveria "\linkCERJ")
\newcommand{\mostrarlink}[1]{\expandafter\url\expandafter{#1}}

% Link nos slides, com o ícone de "abre fora": \linkexterno{\linkCERJ}{cerj.org.br}
% (nas referências ABNT, use \mostrarlink, sem ícone)
\newcommand{\linkexterno}[2]{\href{#1}{\faExternalLink*~#2}}   % ~: ícone não separa do texto

% URLs longos quebram em qualquer caractere (senão vazam do slide)
\RequirePackage{xurl}


% ---------------------------------------------------------------------------
% Referências (ABNT, sistema autor-data)
% ---------------------------------------------------------------------------
% Citações com natbib (autor-data). Cada entrada:
%   \bibitem[Maxwell(2000)]{maxwell2000} texto da referência
% \citep{maxwell2000}         (Maxwell, 2000)
% \citet{maxwell2000}         Maxwell (2000)
% \citep[p.~3]{maxwell2000}   (Maxwell, 2000, p. 3)
% Atenção: no natbib, \cite equivale a \citet, não a \citep.
% Na lista, sem rótulo nem recuo, alinhada à esquerda, como pede a ABNT.
\RequirePackage{natbib}
\setcitestyle{authoryear, round, aysep={,}, yysep={;}, notesep={, }}
% O beamer carrega o hyperref com implicit=false, que transforma esta macro
% num stub vazio e engole o ", " e o " (" entre autor e ano. Devolve o texto.
\def\hyper@natlinkbreak#1#2{#1}
\renewcommand{\bibsection}{}                    % o título vem do frame
\setlength{\bibhang}{0pt}                       % sem recuo pendente
\setbeamertemplate{bibliography item}{}
% Letra menor, sem justificar, e sem o recuo do rótulo (labelsep) que sobraria
\AtBeginEnvironment{thebibliography}{\footnotesize\raggedright\setlength{\labelsep}{0pt}}
\setbeamertemplate{frametitle continuation}{}   % "Referências", não "Referências I"


% ---------------------------------------------------------------------------
% Figuras TikZ (fontes em figuras/, PDFs em img/, compilados pelo latexmkrc)
% ---------------------------------------------------------------------------
% \figura[opções]{nome}: inclui img/nome.pdf, sem escala para manter a fonte
% do tamanho do slide. Serve também para os PDFs gerados por tools/*.py.
% Além disso abre figuras/nome.tex (sem ler nada) só para o arquivo entrar no
% .fls como dependência: assim o latexmk -pvc recompila quando a figura muda.
% (\IfFileExists não serve: não abre o arquivo.)
\newread\cerj@leitura
\newcommand{\cerj@dependencia}[1]{\openin\cerj@leitura=#1\relax\closein\cerj@leitura}
\newcommand{\cerj@registrafonte}[1]{\cerj@dependencia{figuras/#1.tex}}
% Mudar a classe das figuras também deve disparar o -pvc
\cerj@dependencia{engine/cerj-figura.cls}
\newcommand{\figura}[2][]{\cerj@registrafonte{#2}\includegraphics[#1]{#2}}

% \figurapassos{nome}{n}: figura de n páginas, uma por passo do slide
% (página k no passo k; a última fica até o fim do slide).
\newcommand{\figurapassos}[2]{%
  \cerj@registrafonte{#1}%
  \foreach \cerj@passo in {1,...,#2}{%
    \ifnum\cerj@passo<#2
      \only<\cerj@passo>{\includegraphics[page=\cerj@passo]{#1}}%
    \else
      \only<\cerj@passo->{\includegraphics[page=\cerj@passo]{#1}}%
    \fi}}


% ---------------------------------------------------------------------------
% Abreviações
% ---------------------------------------------------------------------------
\newcommand{\CERJ}{\textsc{cerj}\xspace}


% Indicativo de chamada em monoespaçado: \indicativo{PY1XXX}
% Herda a cor do texto, então funciona em fundo claro e escuro.
\newcommand{\indicativo}[1]{{\ttfamily #1}}

% \destaque{termo}: como o \alert (laranja e negrito), mas sem overlay; para
% dentro de tabelas, onde o \alert do beamer desalinha as colunas.
\newcommand{\destaque}[1]{\textcolor{cerjOrange}{\bfseries #1}}

% ---------------------------------------------------------------------------
% Caixas de destaque (tcolorbox)
% ---------------------------------------------------------------------------
\tcbset{
  cerjbox/.style={
    enhanced,
    boxrule=0pt,
    leftrule=3pt,
    arc=0pt,
    outer arc=0pt,
    left=6pt, right=6pt, top=4pt, bottom=4pt,
    fonttitle=\bfseries\small,
    coltitle=white,
    toptitle=2pt, bottomtitle=2pt,
    attach boxed title to top left={yshift=-\tcboxedtitleheight/2, xshift=6pt},
    boxed title style={arc=0pt, boxrule=0pt, left=4pt, right=4pt},
    before upper={\vspace{0.4em}},
  },
}

% \begin{dica} ... \end{dica}
\newtcolorbox{dica}[1][]{
  cerjbox,
  colback=cerjGreenDark!8!cerjPaper,
  colframe=cerjGreenDark,
  colbacktitle=cerjGreenDark,
  title={\faLightbulb\ Dica},
  #1
}

% \begin{atencao} ... \end{atencao}
\newtcolorbox{atencao}[1][]{
  cerjbox,
  colback=cerjYellow!55!cerjPaper,
  colframe=cerjNavy,
  colbacktitle=cerjNavy,
  title={\faExclamationTriangle\ Atenção},
  #1
}

% \begin{regulamento} ... \end{regulamento}
\newtcolorbox{regulamento}[1][]{
  cerjbox,
  colback=cerjNavy10,
  colframe=cerjNavy,
  colbacktitle=cerjNavy,
  title={\faGavel\ Regulamento},
  #1
}

% ---------------------------------------------------------------------------
% Listas de ✓ e ✗ (prós e contras, "faz" e "não faz")
% ---------------------------------------------------------------------------
% \begin{certos} \item ... \end{certos}     marcador ✓ verde
% \begin{errados} \item ... \end{errados}   marcador ✗ vermelho
% Aceitam as opções do itemize: \begin{certos}[<+->]
\newenvironment{certos}[1][]{%
  \setbeamertemplate{itemize item}{\textcolor{cerjGreenDark}{\faCheck}}%
  \begin{itemize}[#1]}{\end{itemize}}
\newenvironment{errados}[1][]{%
  \setbeamertemplate{itemize item}{\textcolor{cerjRed}{\faTimes}}%
  \begin{itemize}[#1]}{\end{itemize}}

% ---------------------------------------------------------------------------
% Foto com legenda
% ---------------------------------------------------------------------------
% \legenda{texto}                      legenda discreta sob qualquer coisa
% \foto{arquivo}{legenda}              foto na largura da coluna + legenda
% \foto[height=4cm]{arquivo}{legenda}  opções do \includegraphics
% \foto{arquivo}{}                     sem legenda
\newcommand{\legenda}[1]{%
  \par\vspace{0.3em}%
  {\scriptsize\color{cerjMuted}#1\par}%
}
% Comentário com a fonte do \legenda (pequena e acinzentada), onde for escrito:
%   texto com marca\asterisco ...  \comentario{explicação}  ->  "* explicação"
\newcommand{\asterisco}{\textsuperscript{*}}
% (fecha o parágrafo dentro do grupo, para o espaço entre linhas ser o da letra pequena)
\newcommand{\comentario}[1]{{\scriptsize\color{cerjMuted}* #1\par}}
\newcommand{\foto}[3][width=\linewidth]{%
  \includegraphics[#1]{#2}%
  \if\relax\detokenize{#3}\relax\else\legenda{#3}\fi
}

% ---------------------------------------------------------------------------
% Foto em tela cheia com faixa de legenda
% ---------------------------------------------------------------------------
% \cerjfullimage[opções do includegraphics]{arquivo}{legenda}
% Por padrão a imagem ocupa toda a largura e é cortada em altura; para fotos
% em retrato use [height=\paperheight].
\newcommand{\cerjfullimage}[3][width=\paperwidth]{%
  \frame[plain,noframenumbering]{%
    \begin{tikzpicture}[remember picture, overlay]
      \clip (current page.south west) rectangle (current page.north east);
      \node[inner sep=0pt] at (current page.center)
        {\includegraphics[#1]{#2}};
      % A faixa passa 1pt das bordas esquerda, inferior e direita (o \clip
      % corta o excesso): encosta nos cantos sem deixar fresta de anti-aliasing.
      % outer sep=0pt: sem ele a âncora fica fora da área pintada.
      \node[
        anchor=south west, outer sep=0pt,
        fill=cerjNavy, fill opacity=0.85,
        text opacity=1, text=white,
        text width=\dimexpr\paperwidth-20pt\relax,
        inner xsep=11pt, inner ysep=8pt,
        align=left,
      ] at ([shift={(-1pt,-1pt)}]current page.south west) {#3};
    \end{tikzpicture}%
  }%
}

\endinput
