%% beamerthemecerj.sty
%% Tema CERJ construído sobre o metropolis (mtheme).
%% Carregue com \usetheme{cerj} (engine/ precisa estar no TEXINPUTS ou em \input@path).
%% Paleta em cerj-cores.sty.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemecerj}[2026/11/07 v0.1 Tema CERJ sobre metropolis]

\RequirePackage{etoolbox}
\RequirePackage{graphicx}
\RequirePackage{tikz}

% ---------------------------------------------------------------------------
% Base: metropolis
% ---------------------------------------------------------------------------
\usetheme[
  progressbar=frametitle,   % barra de progresso sob o título do slide
  numbering=fraction,       % "3 / 20" no rodapé
  block=fill,               % blocos com fundo
  sectionpage=none,         % desenhamos a nossa própria página de seção abaixo
  subsectionpage=none,
  titleformat=regular,
  background=light,
]{metropolis}

% ---------------------------------------------------------------------------
% Paleta
% ---------------------------------------------------------------------------
\RequirePackage{cerj-cores}   % cores do logo e derivadas

% Texto e estrutura
\setbeamercolor{normal text}{fg=cerjInk, bg=cerjPaper}
\setbeamercolor{alerted text}{fg=cerjLaranja}
\setbeamerfont{alerted text}{series=\bfseries}   % \alert: laranja e negrito
\setbeamercolor{example text}{fg=cerjBlue}
\setbeamercolor{structure}{fg=cerjNavy}
\setbeamercolor{palette primary}{fg=white, bg=cerjNavy}   % usado por [standout]

% Título do slide e barras de progresso
\setbeamercolor{frametitle}{fg=white, bg=cerjNavy}
\setbeamercolor{progress bar}{fg=cerjGreen, bg=cerjAzul20}
\setbeamercolor{progress bar in head/foot}{fg=cerjGreen, bg=cerjAzul80}
\setbeamercolor{progress bar in section page}{fg=cerjGreen, bg=cerjAzul80}
\setbeamercolor{title separator}{fg=cerjGreen}

% Blocos
\setbeamercolor{block title}{fg=white, bg=cerjNavy}
\setbeamercolor{block body}{fg=cerjInk, bg=cerjAzul10}
\setbeamercolor{block title alerted}{fg=white, bg=cerjGreenDark}
\setbeamercolor{block body alerted}{fg=cerjInk, bg=cerjGreenDark!10!cerjPaper}
\setbeamercolor{block title example}{fg=white, bg=cerjRoyal}
\setbeamercolor{block body example}{fg=cerjInk, bg=cerjAzul10}

% Listas, rodapé, sumário
\setbeamercolor{itemize item}{fg=cerjGreenDark}
\setbeamercolor{itemize subitem}{fg=cerjGreenDark}
\setbeamercolor{enumerate item}{fg=cerjGreenDark}
\setbeamercolor{footline}{fg=cerjInk!65!cerjPaper}
\setbeamercolor{page number in head/foot}{fg=cerjInk!65!cerjPaper}
\setbeamercolor{section in toc}{fg=cerjInk}
\setbeamercolor{section number projected}{fg=white, bg=cerjGreenDark}
\setbeamertemplate{section in toc}[sections numbered]

% Página de seção (fundo navy, aplicado em \AtBeginSection)
\setbeamercolor{section title}{fg=white}
\setbeamercolor{subsection title}{fg=cerjAzul20}

% Links: verde escuro sobre o fundo claro; nos slides [standout] (fundo azul),
% o verde claro do emblema, que o verde escuro ficaria ilegível. Ali o \alert
% também troca para o laranja claro. As duas trocas valem só dentro do grupo
% que o metropolis abre para o standout.
\hypersetup{colorlinks=true, linkcolor=., urlcolor=cerjGreenDark, citecolor=cerjGreenDark}
\apptocmd{\KV@beamerframe@standout}{\hypersetup{urlcolor=cerjGreen, citecolor=cerjGreen}%
  \setbeamercolor{alerted text}{fg=cerjLaranjaClaro}}{}%
  {\PackageWarning{beamerthemecerj}{Não deu para ajustar a cor dos links no standout}}

% ---------------------------------------------------------------------------
% Logotipo
% ---------------------------------------------------------------------------
% Arquivo: img/cerj-logo.png (150 px; troque por versão em alta resolução
% ou vetorial mantendo o nome, nada mais precisa mudar).
\newcommand{\cerjlogofile}{cerj-logo}
\newcommand{\cerjlogo}[1][height=1.5cm]{\includegraphics[#1]{\cerjlogofile}}

% Logo na capa clara (\maketitle do metropolis, canto superior esquerdo).
% A capa escura (\cerjtitleframe) posiciona o logo por conta própria.
\titlegraphic{\hfill\cerjlogo[height=1.1cm]}

% Rodapé: logo pequeno + título curto + instituição curta
\newcommand{\cerjfootertext}{\insertshorttitle\ \textperiodcentered\ \insertshortinstitute}
\setbeamertemplate{frame footer}{%
  \raisebox{-0.45ex}{\cerjlogo[height=1.9ex]}\hspace{0.5em}\cerjfootertext
}

% ---------------------------------------------------------------------------
% Página de título com fundo navy
% ---------------------------------------------------------------------------
% Use \cerjtitleframe no lugar de \maketitle: texto à esquerda, logo grande
% à direita, separador verde. (\maketitle continua disponível para uma capa
% clara no estilo metropolis.)
\newcommand{\cerjtitleframe}{%
  \begingroup
    \setbeamercolor{background canvas}{bg=cerjNavy}%
    \setbeamercolor{normal text}{fg=white, bg=cerjNavy}%
    \frame[plain,noframenumbering]{%
      \begin{tikzpicture}[remember picture, overlay]
        \node[anchor=east, inner sep=0pt]
          at ([xshift=-1.1cm]current page.east) {\cerjlogo[height=3cm]};
      \end{tikzpicture}%
      \begin{minipage}[c]{0.64\textwidth}
        \raggedright
        {\usebeamerfont{title}\color{white}\inserttitle\par}
        \ifx\insertsubtitle\@empty\else
          \vspace{0.5em}%
          {\usebeamerfont{subtitle}\color{cerjGreen}\insertsubtitle\par}
        \fi
        \vspace{0.8em}%
        {\color{cerjGreen}\rule{\linewidth}{0.6pt}}\par
        \vspace{0.9em}%
        {\usebeamerfont{author}\color{white}\insertauthor\par}
        \vspace{0.3em}%
        {\usebeamerfont{date}\color{cerjAzul20}\insertdate\par}
        \vspace{0.2em}%
        {\usebeamerfont{institute}\color{cerjAzul20}\insertinstitute\par}
      \end{minipage}%
    }%
  \endgroup
}

% ---------------------------------------------------------------------------
% Página de seção: fundo navy; "Parte N", título e barra verde de progresso
% centralizados no slide, com o logo à esquerda do texto (fora da centralização).
% ---------------------------------------------------------------------------
\newcommand{\cerjsectionlabel}{Parte}
\newcommand{\cerjsectionlogoheight}{1.84cm}
\newcommand{\cerjsectionmaxwidth}{0.58\textwidth} % títulos maiores quebram linha

\newsavebox{\cerj@secbox}
\newlength{\cerj@secwidth}

\setbeamertemplate{section page}{%
  % Largura do texto = a do maior entre "Parte N", título e subtítulo,
  % limitada a \cerjsectionmaxwidth; assim o bloco de texto fica centralizado.
  \sbox{\cerj@secbox}{\usebeamerfont{section title}\insertsectionhead}%
  \setlength{\cerj@secwidth}{\wd\cerj@secbox}%
  \sbox{\cerj@secbox}{\usebeamerfont{subsection title}%
    \cerjsectionlabel~\insertsectionnumber}%
  \ifdim\wd\cerj@secbox>\cerj@secwidth \setlength{\cerj@secwidth}{\wd\cerj@secbox}\fi
  \ifx\insertsubsectionhead\@empty\else
    \sbox{\cerj@secbox}{\usebeamerfont{subsection title}\insertsubsectionhead}%
    \ifdim\wd\cerj@secbox>\cerj@secwidth \setlength{\cerj@secwidth}{\wd\cerj@secbox}\fi
  \fi
  \ifdim\cerj@secwidth>\cerjsectionmaxwidth \setlength{\cerj@secwidth}{\cerjsectionmaxwidth}\fi
  \centering
  \sbox{\cerj@secbox}{\cerjlogo[height=\cerjsectionlogoheight]}%
  % \llap: o logo não ocupa largura, então só o texto conta na centralização
  \leavevmode\llap{\parbox[c]{\wd\cerj@secbox}{\usebox{\cerj@secbox}}\hspace{1.4em}}%
  \begin{minipage}[c]{\cerj@secwidth}
    \raggedright
    {\usebeamercolor[fg]{subsection title}\usebeamerfont{subsection title}%
     \cerjsectionlabel~\insertsectionnumber\par}
    \vspace{0.3em}
    {\usebeamercolor[fg]{section title}\usebeamerfont{section title}%
     \insertsectionhead\\[-1ex]}
    \usebeamertemplate*{progress bar in section page}% largura = \textwidth da minipage
    \par
    \ifx\insertsubsectionhead\@empty\else%
      \usebeamercolor[fg]{subsection title}%
      \usebeamerfont{subsection title}%
      \insertsubsectionhead
    \fi
  \end{minipage}%
  \par
}

\AtBeginSection[]{%
  \begingroup
    \setbeamercolor{background canvas}{bg=cerjNavy}%
    \setbeamercolor{normal text}{fg=white, bg=cerjNavy}%
    \frame[plain,noframenumbering,c]{\sectionpage}%
  \endgroup
}

\endinput
